---
import Basis from '../layouts/Basis.astro';
import { url } from '../config';
---
<Basis titel="Seite nicht gefunden">
  <section class="huelle text" style="padding-top: 3rem">
    <h1>No such file or directory</h1>
    <p>Diese Seite gibt es nicht. Vielleicht hat sich die Adresse geändert. Mit <code>cd ~</code> kommst du nach Hause:</p>
    <p><a class="knopf" href={url('')}>Zur Startseite</a></p>
  </section>
</Basis>
