---
import Basis from '../../layouts/Basis.astro';
import { ALLE_MISSIONEN, aktVon, kampagneVon, naechste, vorherige } from '../../data/kampagne';
import { url } from '../../config';

export function getStaticPaths() {
  return ALLE_MISSIONEN.map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params as { id: string };
const mission = ALLE_MISSIONEN.find((x) => x.id === id)!;
const akt = aktVon(id)!;
const kamp = kampagneVon(id);
const vor = vorherige(id);
const nach = naechste(id);

const dateien = import.meta.glob('../../missionen/*.mdx', { eager: true }) as Record<string, { default: any; frontmatter: any }>;
const datei = dateien[`../../missionen/${id}.mdx`];
const Inhalt = datei?.default;
const fm = datei?.frontmatter ?? {};
const checks: { id: string; hardware?: boolean }[] = fm.checks ?? [];
const hatHardware = checks.some((c) => c.hardware);
const meta = { id, xp: mission.xp, checks, abzeichen: fm.abzeichen };
// Spickzettel: Formeln und Werte, die man in dieser Mission braucht. Steht im Frontmatter unter "spick".
const spick: { t: string; v: string }[] = fm.spick ?? [];
---
<Basis titel={`${mission.nr} ${mission.titel}`} beschreibung={mission.kurz}>
  <article class="huelle mission" data-mission={id} data-meta={JSON.stringify(meta)}>
    <nav class="pfad leise klein" aria-label="Brotkrumen">
      <a href={url(`kampagne/${kamp.id}`)}>Kampagne {kamp.nr}: {kamp.titel}</a> / Akt {akt.nr}: {akt.titel}
    </nav>
    <header class="mkopf">
      <p class="mnr">{mission.boss ? (mission.nr.startsWith("Boss") ? `Bosskampf ${akt.nr}` : mission.nr) : `Mission ${mission.nr}`}</p>
      <h1>{mission.titel}</h1>
      <p class="mkurz">{mission.kurz}</p>
      <p class="leise klein"><span data-kw-dauer></span>{mission.xp} XP{checks.length ? `, +10 XP wenn alles im ersten Versuch klappt` : ''}{fm.abzeichen ? `. Abzeichen: ${fm.abzeichen}` : ''}</p>
    </header>

    <div class="sperre" data-kw-sperre hidden>
      <p>Diese Mission ist noch gesperrt. Du kannst alles lesen, aber die Prüfungen zählen erst, wenn du{' '}
        {vor && <a href={url(`mission/${vor.id}`)}>{vor.nr} {vor.titel}</a>} abgeschlossen hast.</p>
    </div>

    {hatHardware && (
      <label class="hw-schalter">
        <input type="checkbox" data-kw-ohne-hardware />
        <span>Ich habe (noch) kein Linux eingerichtet. Prüfungen im echten Linux überspringen und im Simulator weitermachen.</span>
      </label>
    )}

    <div class={spick.length ? 'raster mit-spick' : 'raster'}>
    <div class="spalte">
    <div class="schrittleiste" data-kw-schrittleiste hidden>
      <div class="sl-kopf">
        <p class="sl-titel" aria-live="polite"><span data-sl-nr></span> <strong data-sl-name></strong></p>
        <p class="sl-rest leise klein" data-sl-rest></p>
      </div>
      <ol class="sl-segmente" data-sl-segmente aria-label="Schritte dieser Mission"></ol>
    </div>
    <p class="wieder" data-kw-wieder hidden>Du warst zuletzt hier. <button type="button" class="linkknopf" data-kw-von-vorne>Von vorne beginnen</button></p>

    <div class="inhalt text" data-kw-inhalt>
      {Inhalt ? <Inhalt /> : (
        <section class="entwurf">
          <p><strong>Diese Mission wird gerade geschrieben.</strong> So ist sie geplant:</p>
          <table>
            <tbody>
              <tr><th scope="row">Du tust</th><td>{mission.kurz}</td></tr>
              <tr><th scope="row">Theorie</th><td>{mission.theorie}</td></tr>
              <tr><th scope="row">Prüfung</th><td>{mission.pruefung}</td></tr>
            </tbody>
          </table>
          <p class="leise">Bis dahin kannst du die bisherigen Missionen wiederholen oder deinen Fortschritt sichern.</p>
        </section>
      )}
    </div>
    <nav class="schritt-nav" data-kw-schritt-nav hidden aria-label="Schritte">
      <button type="button" class="knopf zweit" data-sn-zurueck>Zurück</button>
      <span class="sn-lob" data-sn-lob aria-live="polite"></span>
      <button type="button" class="knopf" data-sn-weiter>Weiter</button>
    </nav>
    </div>
    {spick.length > 0 && (
      <aside class="spick" aria-label="Spickzettel">
        <details data-kw-spick open>
          <summary>Spickzettel</summary>
          <dl>
            {spick.map((e) => (<><dt>{e.t}</dt><dd set:html={e.v} /></>))}
          </dl>
          <p class="leise klein">Alles, was du hier brauchst. Du musst dir nichts merken.</p>
        </details>
      </aside>
    )}
    </div>

    <section class="offen" data-kw-offen hidden>
      <h2>Noch offen</h2>
      <p class="leise klein">Die Mission ist geschafft, sobald diese Prüfungen erledigt sind.</p>
      <ul data-offen-liste></ul>
      <p class="leise klein">Hängt etwas oder willst du nur weiter testen? Übersprungene Missionen zählen als „im Simulator geschafft“ und lassen sich jederzeit nachholen.</p>
      <div class="offen-knoepfe">
        <button type="button" class="knopf zweit" data-offen-hw hidden>Ich habe kein Linux</button>
        <button type="button" class="knopf zweit" data-offen-alle>Ganze Mission überspringen</button>
      </div>
    </section>
    <section class="belohnung" data-kw-belohnung hidden aria-live="polite">
      <h2 data-bel-titel>Mission geschafft</h2>
      <p data-bel-text></p>
      {nach && <a class="knopf" href={url(`mission/${nach.id}`)}>Weiter mit {nach.nr}: {nach.titel}</a>}
    </section>

    <nav class="blaettern" aria-label="Missionen">
      {vor ? <a href={url(`mission/${vor.id}`)}>Zurück: {vor.nr} {vor.titel}</a> : <span></span>}
      {nach && <a href={url(`mission/${nach.id}`)}>Nächste: {nach.nr} {nach.titel}</a>}
    </nav>
  </article>
</Basis>

<script>
  import { istFertig, istFreigeschaltet, laden, missionRegistrieren, setOhneHardware, beiAenderung } from '../../scripts/engine';
  const art = document.querySelector<HTMLElement>('[data-mission]')!;
  const meta = JSON.parse(art.dataset.meta!);
  missionRegistrieren(meta);

  const sperre = document.querySelector<HTMLElement>('[data-kw-sperre]')!;
  sperre.hidden = istFreigeschaltet(meta.id);

  const hw = document.querySelector<HTMLInputElement>('[data-kw-ohne-hardware]');
  if (hw) {
    hw.checked = laden().ohneHardware;
    hw.addEventListener('change', () => setOhneHardware(hw.checked));
  }

  const bel = document.querySelector<HTMLElement>('[data-kw-belohnung]')!;
  function belohnungZeigen(frisch: boolean, info?: { status: string; xp: number; ersterVersuch: boolean; upgrade: boolean }) {
    const eintrag = laden().missionen[meta.id];
    if (!eintrag) return;
    bel.hidden = false;
    bel.classList.toggle('frisch', frisch);
    bel.querySelector('[data-bel-titel]')!.textContent = eintrag.status === 'real' ? 'Mission geschafft' : 'Im Simulator geschafft';
    const teile = [];
    if (frisch && info) {
      teile.push(info.upgrade ? 'Jetzt auch im echten Linux bestanden.' : `+${info.xp} XP${info.ersterVersuch ? ' (inklusive Bonus für den ersten Versuch)' : ''}.`);
      if (meta.abzeichen && !info.upgrade) teile.push(`Neues Abzeichen: ${meta.abzeichen}.`);
    } else teile.push(`Du hast diese Mission bereits abgeschlossen (${eintrag.xp} XP).`);
    if (eintrag.status === 'simuliert') teile.push('Sobald dein Linux läuft, kannst du die übersprungenen Prüfungen nachholen. Dann leuchtet dein Einschub farbig.');
    bel.querySelector('[data-bel-text]')!.textContent = teile.join(' ');
    if (frisch) bel.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
  }
  if (istFertig(meta.id)) belohnungZeigen(false);
  window.addEventListener('kw:mission-fertig', (e) => {
    const d = (e as CustomEvent).detail;
    if (d.id === meta.id) belohnungZeigen(true, d);
  });
  beiAenderung(() => { sperre.hidden = istFreigeschaltet(meta.id); });

  // ---------- Schritt für Schritt ----------
  import { einstellungen, letzterSchritt, schrittMerken, wenigBewegung } from '../../scripts/einstellungen';
  import { checkBestanden, checkUeberspringen } from '../../scripts/engine';

  const inhalt = document.querySelector<HTMLElement>('[data-kw-inhalt]')!;
  const leiste = document.querySelector<HTMLElement>('[data-kw-schrittleiste]')!;
  const snav = document.querySelector<HTMLElement>('[data-kw-schritt-nav]')!;
  const wieder = document.querySelector<HTMLElement>('[data-kw-wieder]')!;
  const weiterK = snav.querySelector<HTMLButtonElement>('[data-sn-weiter]')!;
  const zurueckK = snav.querySelector<HTMLButtonElement>('[data-sn-zurueck]')!;
  const lob = snav.querySelector<HTMLElement>('[data-sn-lob]')!;

  // Inhalt in Abschnitte teilen: neuer Schritt bei jeder Zwischenüberschrift und jede Prüfung als eigener Schritt.
  interface Schritt { el: HTMLElement; name: string; checks: string[]; minuten: number; karte?: boolean; }
  const schritte: Schritt[] = [];
  function neu(name: string) {
    const el = document.createElement('section');
    el.className = 'schritt';
    el.tabIndex = -1;
    schritte.push({ el, name, checks: [], minuten: 0 });
    return schritte[schritte.length - 1];
  }
  const knoten = [...inhalt.childNodes];
  let akt: Schritt | null = null;
  for (const n of knoten) {
    const el = n.nodeType === 1 ? (n as HTMLElement) : null;
    const istStation = !!el?.matches('[data-kw-check]');
    const istH2 = el?.tagName === 'H2';
    const unsichtbar = el && ['SCRIPT', 'STYLE'].includes(el.tagName);
    if (istStation) {
      // Die Übung gehört zum Abschnitt davor (Erklärung und Frage auf einem Bildschirm).
      // Hat der Abschnitt schon eine Übung, bekommt die neue einen eigenen Schritt.
      if (!akt || akt.checks.length) akt = neu(el!.querySelector('h3')?.textContent?.trim() ?? 'Prüfung');
      akt.checks.push(el!.dataset.kwCheck!);
      akt.el.append(n);
      continue;
    }
    if (el?.matches('.karte')) {
      // Jede Theorie-Karte ist ein eigener Gedanke und bekommt einen eigenen Bildschirm.
      const name = el.querySelector('h3')?.textContent?.replace(/^\d+/, '').trim() ?? 'Theorie';
      if (akt && !akt.karte && !akt.checks.length) akt.name = name;
      else akt = neu(name);
      akt.karte = true;
      akt.el.append(n);
      continue;
    }
    if (istH2) akt = neu(el!.textContent?.trim() ?? '');
    else if (akt?.checks.length && !unsichtbar && (el || n.textContent?.trim())) akt = null; // nach einer Übung geht es auf einem neuen Bildschirm weiter
    if (!akt) {
      if (!el && !n.textContent?.trim()) { inhalt.append(n); continue; }
      if (unsichtbar) { inhalt.append(n); continue; }
      const titelEl = el?.matches('details') ? el.querySelector('summary') : el?.querySelector('h3, .titel, summary');
      akt = neu(schritte.length ? (titelEl?.textContent?.replace(/^Vertiefung:\s*/, '').trim() || 'Fortsetzung') : 'Worum es geht');
    }
    akt.el.append(n);
  }
  // Kurze Restschnipsel (z. B. nur ein Satz nach einer Prüfung) an den vorigen Schritt hängen
  for (let i = schritte.length - 1; i > 0; i--) {
    const s = schritte[i];
    if (!s.checks.length && !s.el.querySelector('h2') && (s.el.textContent ?? '').trim().split(/\s+/).length < 25) {
      schritte[i - 1].el.append(...s.el.childNodes);
      schritte.splice(i, 1);
    }
  }
  inhalt.append(...schritte.map((s) => s.el));

  // Zeitschätzung: 130 Wörter pro Minute (langsames, gründliches Lesen) plus 1 Minute pro Übung.
  // Eine grobe Faustregel, keine Messung.
  for (const s of schritte) {
    const w = (s.el.textContent ?? '').trim().split(/\s+/).length;
    s.minuten = w / 130 + s.checks.length;
  }
  const gesamt = Math.max(1, Math.round(schritte.reduce((a, s) => a + s.minuten, 0)));
  document.querySelector('[data-kw-dauer]')!.textContent = `ca. ${gesamt} Min. · `;

  const segmente = leiste.querySelector<HTMLOListElement>('[data-sl-segmente]')!;
  schritte.forEach((s, i) => {
    const li = document.createElement('li');
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'seg';
    b.title = s.name;
    b.setAttribute('aria-label', `Schritt ${i + 1}: ${s.name}`);
    b.addEventListener('click', () => zeige(i, true));
    li.append(b);
    segmente.append(li);
  });

  let jetzt = 0;
  const gesehen = new Set<number>();
  const fertig = (s: Schritt) => s.checks.every((c) => checkBestanden(meta.id, c));

  function aktualisieren() {
    const s = schritte[jetzt];
    leiste.querySelector('[data-sl-nr]')!.textContent = `Schritt ${jetzt + 1} von ${schritte.length}:`;
    leiste.querySelector('[data-sl-name]')!.textContent = s.name;
    const rest = Math.round(schritte.slice(jetzt).reduce((a, x) => a + x.minuten, 0));
    leiste.querySelector('[data-sl-rest]')!.textContent = rest <= 1 ? 'Gleich geschafft' : `noch ca. ${rest} Min.`;
    segmente.querySelectorAll<HTMLButtonElement>('.seg').forEach((b, i) => {
      const x = schritte[i];
      b.classList.toggle('jetzt', i === jetzt);
      b.classList.toggle('ok', x.checks.length ? fertig(x) : gesehen.has(i) && i !== jetzt);
      b.classList.toggle('pruefung', x.checks.length > 0);
      if (i === jetzt) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
    });
    zurueckK.hidden = jetzt === 0;
    const letzt = jetzt === schritte.length - 1;
    weiterK.hidden = letzt;
    if (!letzt) weiterK.textContent = `Weiter: ${schritte[jetzt + 1].name}`;
    const geschafft = s.checks.length > 0 && fertig(s);
    weiterK.classList.toggle('bereit', geschafft);
    const nOffen = offeneChecks().length;
    lob.textContent = geschafft ? (nOffen && !istFertig(meta.id) ? `Geschafft. Noch ${nOffen} ${nOffen === 1 ? 'Prüfung' : 'Prüfungen'} offen.` : 'Geschafft.') : '';
    offenAktualisieren();
  }

  function zeige(i: number, scrollen: boolean) {
    jetzt = Math.max(0, Math.min(schritte.length - 1, i));
    gesehen.add(jetzt);
    schritte.forEach((s, k) => (s.el.hidden = k !== jetzt));
    schrittMerken(meta.id, jetzt);
    wieder.hidden = true;
    aktualisieren();
    if (scrollen) {
      schritte[jetzt].el.style.scrollMarginTop = `${leiste.offsetHeight + 16}px`;
      schritte[jetzt].el.scrollIntoView({ behavior: wenigBewegung() ? 'auto' : 'smooth', block: 'start' });
      schritte[jetzt].el.focus({ preventScroll: true });
    }
  }

  function modus() {
    const an = einstellungen().schritte && schritte.length > 1;
    leiste.hidden = !an;
    snav.hidden = !an;
    if (an) {
      const start = letzterSchritt(meta.id);
      zeige(start < schritte.length ? start : 0, false);
      if (start > 0 && start < schritte.length && !istFertig(meta.id)) wieder.hidden = false;
    } else {
      schritte.forEach((s) => (s.el.hidden = false));
      wieder.hidden = true;
    }
    offenAktualisieren();
  }

  // ---------- Was fehlt noch? ----------
  const offen = document.querySelector<HTMLElement>('[data-kw-offen]')!;
  const offenListe = offen.querySelector<HTMLElement>('[data-offen-liste]')!;
  const offenAlle = offen.querySelector<HTMLButtonElement>('[data-offen-alle]')!;
  const offenHw = offen.querySelector<HTMLButtonElement>('[data-offen-hw]')!;
  offenHw.addEventListener('click', () => { setOhneHardware(true); if (hw) hw.checked = true; });
  function offeneChecks() {
    const z = laden();
    return (meta.checks as { id: string; hardware?: boolean }[]).filter((c) => !checkBestanden(meta.id, c.id) && !(c.hardware && z.ohneHardware));
  }
  function offenAktualisieren() {
    const liste = offeneChecks();
    const amEnde = leiste.hidden || jetzt === schritte.length - 1;
    // Auch mitten in der Mission zeigen, sobald der aktuelle Schritt geschafft ist oder nur noch Hardware fehlt.
    const schrittGeschafft = !leiste.hidden && schritte[jetzt].checks.length > 0 && fertig(schritte[jetzt]);
    const nurHardware = liste.length > 0 && liste.every((c) => c.hardware);
    offen.hidden = istFertig(meta.id) || !liste.length || !(amEnde || schrittGeschafft || nurHardware) || !istFreigeschaltet(meta.id);
    if (offen.hidden) return;
    offenListe.innerHTML = '';
    for (const c of liste) {
      const st = document.querySelector<HTMLElement>(`[data-kw-check="${c.id}"]`);
      const li = document.createElement('li');
      const name = st?.querySelector('h3')?.textContent?.trim() || c.id;
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'linkknopf';
      b.textContent = name + (c.hardware ? ' (im echten Linux)' : '');
      b.addEventListener('click', () => {
        const i = schritte.findIndex((x) => x.checks.includes(c.id));
        if (!leiste.hidden && i >= 0) zeige(i, false);
        st?.scrollIntoView({ behavior: wenigBewegung() ? 'auto' : 'smooth', block: 'start' });
      });
      li.append(b);
      offenListe.append(li);
    }
    offenHw.hidden = !liste.some((c) => c.hardware);
    offenAlle.dataset.sicher = '';
    offenAlle.textContent = 'Ganze Mission überspringen';
  }
  offenAlle.addEventListener('click', () => {
    if (offenAlle.dataset.sicher !== '1') { offenAlle.dataset.sicher = '1'; offenAlle.textContent = 'Wirklich? Noch einmal tippen.'; return; }
    for (const c of offeneChecks()) checkUeberspringen(meta.id, c.id);
  });
  beiAenderung(offenAktualisieren);

  weiterK.addEventListener('click', () => zeige(jetzt + 1, true));
  zurueckK.addEventListener('click', () => zeige(jetzt - 1, true));
  document.querySelector('[data-kw-von-vorne]')!.addEventListener('click', () => zeige(0, true));
  window.addEventListener('kw:einstellungen', modus);
  beiAenderung(() => { if (!leiste.hidden) aktualisieren(); });
  modus();

  // Spickzettel auf kleinen Bildschirmen zugeklappt starten
  const spick = document.querySelector<HTMLDetailsElement>('[data-kw-spick]');
  if (spick && matchMedia('(max-width: 1000px)').matches) spick.open = false;
</script>

<style>
  .mission { padding-top: 1.5rem; }
  .pfad { margin-bottom: 1.5rem; }
  .pfad a { color: var(--leise); }
  .mkopf { max-width: var(--breite); margin-bottom: 1.5rem; }
  .mnr { color: var(--akzent-hell); font-weight: 700; margin-bottom: 0.3rem; }
  .mkurz { font-size: 1.2rem; }
  .sperre { max-width: var(--breite); border: 1px solid var(--warnung); border-radius: var(--radius); padding: 0.8rem 1rem 0; margin-bottom: 1.5rem; color: var(--warnung); }
  .hw-schalter { max-width: var(--breite); display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.8rem 1rem; border: 1px dashed var(--leise-dunkel); border-radius: var(--radius); margin-bottom: 1.5rem; cursor: pointer; }
  .hw-schalter input { margin-top: 0.3rem; width: 1.1rem; height: 1.1rem; accent-color: var(--akzent); flex: none; }
  .inhalt :global(h2:first-child) { margin-top: 0.5rem; }
  .entwurf { border: 1px dashed var(--leise-dunkel); border-radius: var(--radius); padding: 1rem 1.2rem; }
  .offen { max-width: var(--breite); margin: 2rem 0 1rem; padding: 1.2rem 1.5rem; border-radius: var(--radius); background: var(--flaeche); border: 2px dashed var(--warnung); }
  .offen h2 { margin-top: 0; }
  .offen ul { margin: 0.6rem 0 1rem; }
  .offen li { margin: 0.3rem 0; }
  .offen :global(li button) { font: inherit; color: var(--akzent-hell); background: none; border: 0; padding: 0.2rem 0; text-align: left; text-decoration: underline; cursor: pointer; }
  .offen-knoepfe { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .belohnung { max-width: var(--breite); margin: 2.5rem 0 1rem; padding: 1.4rem 1.5rem; border-radius: var(--radius); background: var(--flaeche); border: 2px solid var(--akzent); }
  .belohnung h2 { margin-top: 0; }
  .belohnung.frisch { animation: aufleuchten 1.2s ease-out; }
  @keyframes aufleuchten { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--akzent-hell) 90%, transparent); } 100% { box-shadow: 0 0 0 18px color-mix(in srgb, var(--akzent-hell) 0%, transparent); } }
  .raster.mit-spick { display: grid; grid-template-columns: minmax(0, var(--breite)) 17rem; gap: 2.5rem; align-items: start; }
  .spalte { min-width: 0; max-width: var(--breite); }
  .spick { position: sticky; top: 1rem; }
  .spick details { background: var(--flaeche-leicht); border: 1px solid var(--flaeche); border-radius: var(--radius); padding: 0.8rem 1rem; }
  .spick summary { font-weight: 700; cursor: pointer; color: var(--akzent-hell); }
  .spick dl { margin: 0.7rem 0 0.6rem; }
  .spick dt { color: var(--leise); font-size: 0.85rem; margin-top: 0.6rem; }
  .spick dd { margin: 0.1rem 0 0; font-weight: 700; }
  @media (max-width: 1000px) {
    .raster.mit-spick { display: block; }
    .spick { position: fixed; top: auto; right: 0.8rem; bottom: 0.8rem; left: auto; z-index: 5; max-width: min(22rem, calc(100vw - 1.6rem)); }
    .spick details { box-shadow: 0 6px 24px rgba(0, 0, 0, 0.6); max-height: 65vh; overflow-y: auto; }
    .spick details:not([open]) { padding: 0.5rem 0.9rem; border-color: var(--akzent); }
  }
  .schrittleiste { position: sticky; top: 0; z-index: 4; background: var(--grund); padding: 0.7rem 0 0.8rem; margin-bottom: 0.8rem; border-bottom: 1px solid var(--flaeche); }
  .sl-kopf { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
