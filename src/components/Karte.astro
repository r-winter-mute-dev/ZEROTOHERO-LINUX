---
// Theorie-Karte: höchstens ~120 Wörter, eine Kernaussage.
interface Props { titel: string; nr?: number; }
const { titel, nr } = Astro.props;
---
<article class="karte">
  <h3>{nr !== undefined && <span class="nr">{nr}</span>}{titel}</h3>
  <slot />
</article>

<style>
  .karte { border: 1px solid var(--flaeche); border-radius: var(--radius); padding: 1rem 1.2rem 0.4rem; margin: 1rem 0; background: var(--flaeche-leicht); }
  h3 { margin-top: 0; display: flex; gap: 0.6rem; align-items: center; }
  .nr { display: inline-grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 50%; border: 2px solid var(--akzent); color: var(--akzent-hell); font-size: 0.95rem; flex: none; }
</style>
